{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${ADMINESP_VERSION}",
	"name": "AdminESP",
	"description": "Player outlines for admin_system admins, sent only to them: every living player gets an invisible bone-merge relay and a glowing prop_dynamic copy whose transmit bits are cleared for everybody except an admin whose ESP is on (and whom admin_flag_all/admin_flag_death allow - always, or only while dead or spectating). ESP is off until an admin types !esp / mm_esp or uses the \"players\" admin menu item; the viewer's client is also told mp_forcecamera 0 and mp_playerid 0 while the outlines are on. Config and phrases keep the Metamod names: adminesp.ini and AdminESP.phrases.txt. A port of the Metamod:Source plugin 'AdminESP'.",
	"author": "ezekutor, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/AdminESP",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "admin_system",
			"constraints": ">=1.0.0"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	],
	"methods": []
}
